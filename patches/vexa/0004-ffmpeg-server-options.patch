diff --git a/fftools/ffmpeg_report.c b/fftools/ffmpeg_report.c
new file mode 100644
index 0000000..60eed9d
--- /dev/null
+++ b/fftools/ffmpeg_report.c
@@ -0,0 +1,295 @@
+/*
+ * Progress and log reporting to the media server that started this process.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "ffmpeg_report.h"
+
+#include "libavcodec/avcodec.h"
+#include "libavutil/avstring.h"
+#include "libavutil/bprint.h"
+#include "libavutil/channel_layout.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/thread.h"
+
+static const char *progress_url;
+static int         server_log_level = AV_LOG_QUIET;
+
+static AVMutex     request_mutex = AV_MUTEX_INITIALIZER;
+static _Thread_local int in_request;   // no reporting from inside a report (the HTTP code logs too)
+
+// RFC 3986 percent-encoding of everything but the unreserved characters
+static void bprint_url_escaped(AVBPrint *b, const char *s)
+{
+    for (; *s; s++) {
+        unsigned char c = *s;
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+            c == '-' || c == '_' || c == '.' || c == '~')
+            av_bprint_chars(b, c, 1);
+        else
+            av_bprintf(b, "%%%02X", c);
+    }
+}
+
+// one request on its own connection; the reply body is read and dropped
+static void http_request(const char *url, const char *method)
+{
+    AVIOContext *io = NULL;
+    AVDictionary *opts = NULL;
+    uint8_t buf[1024];
+
+    if (in_request)
+        return;
+    in_request = 1;
+    ff_mutex_lock(&request_mutex);
+
+    av_dict_set(&opts, "method", method, 0);
+    if (avio_open2(&io, url, AVIO_FLAG_READ, NULL, &opts) >= 0) {
+        while (avio_read(io, buf, sizeof(buf)) > 0)
+            ;
+        avio_closep(&io);
+    }
+    av_dict_free(&opts);
+
+    ff_mutex_unlock(&request_mutex);
+    in_request = 0;
+}
+
+static void put_query(const char *query)
+{
+    AVBPrint b;
+    av_bprint_init(&b, 0, AV_BPRINT_SIZE_AUTOMATIC);
+    av_bprintf(&b, "%s?%s", progress_url, query);
+    if (av_bprint_is_complete(&b))
+        http_request(b.str, "PUT");
+    av_bprint_finalize(&b, NULL);
+}
+
+/* log forwarding: whole lines, per thread */
+static void report_log_callback(void *ptr, int level, const char *fmt, va_list vl)
+{
+    static _Thread_local char cur_line[1024];
+    char line[1024];
+    int print_prefix;
+    va_list vl2;
+
+    va_copy(vl2, vl);
+    av_log_default_callback(ptr, level, fmt, vl2);
+    va_end(vl2);
+
+    if (level > server_log_level || in_request || !progress_url)
+        return;
+
+    print_prefix = cur_line[0] == 0;
+    av_log_format_line(ptr, level, fmt, vl, line, sizeof(line), &print_prefix);
+    av_strlcat(cur_line, line, sizeof(cur_line));
+    if (print_prefix) {   // the line is complete
+        size_t len = strlen(cur_line);
+        if (len) {
+            AVBPrint b;
+            // server levels: 0 error, 1 warning, 2 info, 3 debug, 4 verbose
+            int server_level = level < AV_LOG_ERROR ? 0 : level / 8 - 2;
+            if (cur_line[len - 1] == '\n')
+                cur_line[len - 1] = 0;
+            av_bprint_init(&b, 0, AV_BPRINT_SIZE_AUTOMATIC);
+            av_bprintf(&b, "%s/log?level=%d&message=", progress_url, server_level);
+            bprint_url_escaped(&b, cur_line);
+            if (av_bprint_is_complete(&b))
+                http_request(b.str, "POST");
+            av_bprint_finalize(&b, NULL);
+        }
+        cur_line[0] = 0;
+    }
+}
+
+int report_opt_noop(void *optctx, const char *opt, const char *arg)
+{
+    return 0;   // already applied by report_init()
+}
+
+int report_enabled(void)
+{
+    return progress_url != NULL;
+}
+
+void report_init(int argc, char **argv, const OptionDef *options)
+{
+    int idx = locate_option(argc, argv, options, "progressurl");
+    if (idx && argv[idx + 1])
+        progress_url = argv[idx + 1];
+
+    idx = locate_option(argc, argv, options, "loglevel_server");
+    if (idx && argv[idx + 1]) {
+        static const struct { const char *name; int level; } levels[] = {
+            { "quiet", AV_LOG_QUIET }, { "panic", AV_LOG_PANIC }, { "fatal", AV_LOG_FATAL }, { "error", AV_LOG_ERROR },
+            { "warning", AV_LOG_WARNING }, { "info", AV_LOG_INFO }, { "verbose", AV_LOG_VERBOSE },
+            { "debug", AV_LOG_DEBUG }, { "trace", AV_LOG_TRACE },
+        };
+        const char *arg = argv[idx + 1];
+        char *end;
+        long v = strtol(arg, &end, 10);
+        server_log_level = *end ? AV_LOG_QUIET : (int)v;
+        for (int i = 0; i < FF_ARRAY_ELEMS(levels); i++)
+            if (!strcmp(arg, levels[i].name))
+                server_log_level = levels[i].level;
+        if (server_log_level > AV_LOG_QUIET)
+            av_log_set_callback(report_log_callback);
+    }
+
+}
+
+void report_duration(const AVFormatContext *ic)
+{
+    char q[64];
+    double duration = -1;
+    if (!progress_url)
+        return;
+    if (ic && ic->duration != AV_NOPTS_VALUE)
+        duration = ic->duration / (double)AV_TIME_BASE;
+    snprintf(q, sizeof(q), "duration=%f", duration);
+    put_query(q);
+}
+
+static void report_stream(const AVStream *st, int detail)
+{
+    const AVCodecParameters *par = st->codecpar;
+    const AVDictionaryEntry *lang = av_dict_get(st->metadata, "language", NULL, 0);
+    const char *profile = avcodec_profile_name(par->codec_id, par->profile);
+    AVBPrint b;
+
+    if (st->disposition & AV_DISPOSITION_ATTACHED_PIC)
+        return;
+    if (par->codec_type != AVMEDIA_TYPE_VIDEO && par->codec_type != AVMEDIA_TYPE_AUDIO &&
+        !(detail && par->codec_type == AVMEDIA_TYPE_SUBTITLE))
+        return;
+
+    av_bprint_init(&b, 0, AV_BPRINT_SIZE_AUTOMATIC);
+    av_bprintf(&b, "%s/%s?index=%d&id=%d&codec=%s&type=%s", progress_url, detail ? "streamDetail" : "stream",
+               st->index, st->id, avcodec_get_name(par->codec_id), av_get_media_type_string(par->codec_type));
+    if (detail && par->bit_rate)
+        av_bprintf(&b, "&bitrate=%"PRId64, par->bit_rate);
+    if (detail && profile) {
+        av_bprintf(&b, "&profile=");
+        bprint_url_escaped(&b, profile);
+    }
+    if (detail) {
+        if (lang && lang->value && *lang->value) {
+            av_bprintf(&b, "&language=");
+            bprint_url_escaped(&b, lang->value);
+        }
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO) {
+            av_bprintf(&b, "&width=%d&height=%d", par->width, par->height);
+            av_bprintf(&b, "&interlaced=%d", par->field_order != AV_FIELD_PROGRESSIVE && par->field_order != AV_FIELD_UNKNOWN);
+            if (par->sample_aspect_ratio.num && par->sample_aspect_ratio.den)
+                av_bprintf(&b, "&sar=%d:%d", par->sample_aspect_ratio.num, par->sample_aspect_ratio.den);
+            if (par->level != AV_LEVEL_UNKNOWN)
+                av_bprintf(&b, "&level=%d", par->level);
+            if (st->avg_frame_rate.num && st->avg_frame_rate.den)
+                av_bprintf(&b, "&frameRate=%.3f", av_q2d(st->avg_frame_rate));
+        } else if (par->codec_type == AVMEDIA_TYPE_AUDIO) {
+            char layout[256];
+            char *l, *r, *p = layout;
+            av_channel_layout_describe(&par->ch_layout, layout, sizeof(layout));
+            l = strchr(layout, '(');
+            r = strrchr(layout, ')');
+            if (l && r && l > layout + 8) {   // "6 channels (FL+FR+...)": keep what is inside
+                p = l + 1;
+                *r = 0;
+            }
+            av_bprintf(&b, "&channels=%d&layout=", par->ch_layout.nb_channels);
+            bprint_url_escaped(&b, p);
+            av_bprintf(&b, "&sampleRate=%d", par->sample_rate);
+            if (par->bits_per_raw_sample)
+                av_bprintf(&b, "&bitDepth=%d", par->bits_per_raw_sample);
+        }
+#define DISPOSITION(flag, name) if (st->disposition & AV_DISPOSITION_##flag) av_bprintf(&b, "&disp_" name "=1")
+        DISPOSITION(DEFAULT,          "default");
+        DISPOSITION(DUB,              "dub");
+        DISPOSITION(ORIGINAL,         "original");
+        DISPOSITION(COMMENT,          "comment");
+        DISPOSITION(LYRICS,           "lyrics");
+        DISPOSITION(KARAOKE,          "karaoke");
+        DISPOSITION(FORCED,           "forced");
+        DISPOSITION(HEARING_IMPAIRED, "hearing_impaired");
+        DISPOSITION(VISUAL_IMPAIRED,  "visual_impaired");
+        DISPOSITION(CLEAN_EFFECTS,    "clean_effects");
+        DISPOSITION(ATTACHED_PIC,     "attached_pic");
+        DISPOSITION(TIMED_THUMBNAILS, "timed_thumbnails");
+#undef DISPOSITION
+    }
+    if (av_bprint_is_complete(&b))
+        http_request(b.str, "PUT");
+    av_bprint_finalize(&b, NULL);
+}
+
+void report_input_streams(const AVFormatContext *ic)
+{
+    if (!progress_url)
+        return;
+    for (unsigned i = 0; i < ic->nb_streams; i++)
+        report_stream(ic->streams[i], 0);
+    for (unsigned i = 0; i < ic->nb_streams; i++)
+        report_stream(ic->streams[i], 1);
+}
+
+void report_progress(int64_t pts, int64_t total_size, int64_t cur_time, const AVFormatContext *first_input,
+                     int vdec_hw_status)
+{
+    static int64_t last_time = -1, last_pts = 0;
+    static int last_remaining = 0;
+    int64_t secs, total_secs = 0, run_time;
+    float speed;
+    int remaining, smoothed;
+    char q[256];
+
+    if (!progress_url || pts == AV_NOPTS_VALUE)
+        return;
+    if (last_time < 0) {   // the first call only starts the clock
+        last_time = cur_time;
+        last_pts = pts;
+        return;
+    }
+    run_time = cur_time - last_time;
+    if (run_time <= 0)
+        return;
+    last_time = cur_time;
+
+    secs = pts / AV_TIME_BASE;
+    if (first_input && first_input->duration != AV_NOPTS_VALUE)
+        total_secs = first_input->duration / AV_TIME_BASE;
+
+    // speed as a multiple of real time over the last interval; time left smoothed over two intervals
+    speed = (float)(pts - last_pts) / (float)run_time;
+    remaining = speed > 0 ? (int)((total_secs - secs) / speed) : -1;
+    smoothed = last_remaining ? (int)(last_remaining * 0.5 + remaining * 0.5) : remaining;
+    if (smoothed < 0)
+        smoothed = -1;
+
+    snprintf(q, sizeof(q), "progress=%.1f&size=%lld&remaining=%d&speed=%.1f",
+             total_secs == 0 ? -1.0f : (float)secs * 100.0f / total_secs, (long long)total_size, smoothed, speed);
+    if (vdec_hw_status >= 0)
+        av_strlcatf(q, sizeof(q), "&vdec_hw_status=%d", vdec_hw_status);
+    put_query(q);
+
+    last_remaining = remaining;
+    last_pts = pts;
+}
