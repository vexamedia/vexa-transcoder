+int64_t of_last_mux_time(OutputFile *of)
+{
+    int64_t t = AV_NOPTS_VALUE;
+
+    // furthest timestamp written to this file (AV_TIME_BASE units); a progress estimate, so a racy read is fine
+    for (int i = 0; i < of->nb_streams; i++) {
+        const MuxStream *ms = ms_from_ost(of->streams[i]);
+        const int64_t dts = ms->last_mux_dts;
+        if (dts == AV_NOPTS_VALUE)
+            continue;
+        t = FFMAX(t == AV_NOPTS_VALUE ? INT64_MIN : t, av_rescale_q(dts, ms->ost.st->time_base, AV_TIME_BASE_Q));
+    }
+    return t;
+}
