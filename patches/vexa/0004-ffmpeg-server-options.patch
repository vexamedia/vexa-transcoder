+#if CONFIG_INLINEASS_FILTER
+/* -map_inlineass file:stream: the subtitle stream burned by the inlineass filter (it still needs a decoder, e.g. an
+ * output that maps it to a null muxer) */
+static int opt_map_inlineass(void *optctx, const char *opt, const char *arg)
+{
+    static int fonts_added;
+    StreamSpecifier ss;
+    char *end;
+    long file_idx = strtol(arg, &end, 0);
+    int ret, found = 0;
+
+    if (file_idx < 0 || file_idx >= nb_input_files) {
+        av_log(NULL, AV_LOG_FATAL, "Invalid subtitle input file index: %ld.\n", file_idx);
+        return AVERROR(EINVAL);
+    }
+    ret = stream_specifier_parse(&ss, *end == ':' ? end + 1 : end, 0, NULL);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < input_files[file_idx]->nb_streams && !found; i++) {
+        AVFormatContext *ic = input_files[file_idx]->ctx;
+        if (!stream_specifier_match(&ss, ic, ic->streams[i], NULL))
+            continue;
+        if (ic->streams[i]->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE) {
+            av_log(NULL, AV_LOG_ERROR, "Stream '%s' is not a subtitle stream.\n", arg);
+            continue;
+        }
+        avfilter_inlineass_add_source(file_idx, i);
+        found = 1;
+    }
+    stream_specifier_uninit(&ss);
+    if (!found)
+        av_log(NULL, AV_LOG_ERROR, "Subtitle stream map '%s' matches no streams.\n", arg);
+
+    // fonts attached to the inputs (Matroska attachments)
+    for (int f = 0; f < nb_input_files && !fonts_added; f++) {
+        AVFormatContext *ic = input_files[f]->ctx;
+        for (unsigned i = 0; i < ic->nb_streams; i++) {
+            const AVStream *st = ic->streams[i];
+            const AVDictionaryEntry *name = av_dict_get(st->metadata, "filename", NULL, 0);
+            const char *ext;
+            if (st->codecpar->codec_type != AVMEDIA_TYPE_ATTACHMENT || !st->codecpar->extradata_size || !name)
+                continue;
+            ext = strrchr(name->value, '.');
+            if (st->codecpar->codec_id == AV_CODEC_ID_TTF || st->codecpar->codec_id == AV_CODEC_ID_OTF ||
+                (ext && (!av_strcasecmp(ext, ".ttf") || !av_strcasecmp(ext, ".otf") || !av_strcasecmp(ext, ".ttc"))))
+                avfilter_inlineass_add_font(name->value, st->codecpar->extradata, st->codecpar->extradata_size);
+        }
+    }
+    fonts_added = 1;
+    return 0;
+}
+#endif
