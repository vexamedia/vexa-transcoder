+#define AVFILTER_VF_INLINEASS_H
+
+#include <stdint.h>
+
+#include "libavcodec/avcodec.h"
+
+/*
+ * The inlineass filter burns a subtitle stream that the ffmpeg tool decodes (-map_inlineass file:stream).
+ * The tool registers the stream as a source and hands every decoded subtitle to it; each inlineass instance
+ * (option "source", default 0) reads the source's header and events, so a reconfigured filter graph loses nothing.
+ * These calls are thread safe.
+ */
+int  avfilter_inlineass_add_source(int file_index, int stream_index);
+int  avfilter_inlineass_find_source(int file_index, int stream_index);   // -1 when not burned
+void avfilter_inlineass_add_font(const char *name, const uint8_t *data, int size);
+void avfilter_inlineass_append(int source, const AVCodecContext *dec, const AVSubtitle *sub);
+
+#endif /* AVFILTER_VF_INLINEASS_H */
